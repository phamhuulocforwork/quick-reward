{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 3,
  "version": "1.0.0",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "quick-reward@extension.js",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "name": "Quick Reward",
  "description": "Tự động đổi gift code Delta Force.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "chromium:action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Quick Reward — Lịch sử đổi code"
  },
  "firefox:action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Quick Reward — Lịch sử đổi code"
  },
  "chromium:side_panel": {
    "default_path": "sidebar/index.html",
    "default_title": "Quick Reward"
  },
  "firefox:sidebar_action": {
    "default_panel": "sidebar/index.html",
    "default_title": "Quick Reward",
    "browser_style": false
  },
  "permissions": ["storage", "clipboardRead", "tabs", "cookies"],
  "chromium:permissions": ["sidePanel", "storage", "tabs", "cookies"],
  "host_permissions": ["https://redeem.df.garena.sg/*"],
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": ["background.ts"]
  },
  "content_scripts": [
    {
      "matches": ["https://redeem.df.garena.sg/*"],
      "js": ["content/page-hook.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://redeem.df.garena.sg/*"],
      "js": ["content/scripts.tsx"],
      "run_at": "document_idle"
    }
  ]
}
